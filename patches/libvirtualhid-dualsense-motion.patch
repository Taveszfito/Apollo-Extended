+        // GamepadState gyroscope values use degrees per second. Keep this in
+        // sync with the synthetic calibration report, which advertises 16 raw
+        // DualSense units per degree/second. Artemis converts the physical
+        // controller's integer sample by the inverse factor, so this restores
+        // the exact original value without uneven 1.25-step requantization.
+        write_i16(report, payload_offset + 15U, scale_i16(normalized.gyroscope->x, 16.0F));
+        write_i16(report, payload_offset + 17U, scale_i16(normalized.gyroscope->y, 16.0F));
